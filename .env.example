# Copier ce fichier en .env et renseigner les valeurs (.env n'est jamais commité).

# Clés d'API
MISTRAL_API_KEY=
TAVILY_API_KEY=

# Réglages optionnels (valeurs par défaut indiquées)
# AGENT_HE_MISTRAL_MODEL=mistral-large-latest
# AGENT_HE_UTILISATEUR=moi
# AGENT_HE_DATA_DIR=data
# AGENT_HE_DB_PATH=data/agent_he.sqlite
# AGENT_HE_CHROMA_DIR=data/chroma
# AGENT_HE_CONVENTION_GOUTTES_ML=20
# AGENT_HE_RECHERCHE_OUVERTE=false
# AGENT_HE_MAX_RESULTATS=5
# AGENT_HE_PLONGEUR=local
# AGENT_HE_SEUIL_CORRESPONDANCE=        # défaut : calibré selon le plongeur (0.2 local, 0.8 mistral)
# AGENT_HE_SEUIL_REACTIONS_FORTES=1
# AGENT_HE_SEUIL_REACTIONS_LEGERES=2

# Hébergement Docker (voir README « Hébergement »)
# APP_BIND=127.0.0.1            # adresse d'écoute de l'appli (ex. l'adresse Tailscale)
# UID=1000                      # propriétaire du dossier data/ sur l'hôte (id -u)
# GID=1000                      # (id -g)
# DOMAINE=he.exemple.fr         # profil « web » : nom de domaine pointant vers le serveur
# AUTH_UTILISATEUR=moi
# AUTH_HASH='$2a$14$...'        # docker compose run --rm caddy caddy hash-password ; garder les apostrophes
# IMAGE_CADDY=caddy:2           # image Caddy (remplaçable par un miroir)
